rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if the requester is authenticated with a verified email
    function isVerifiedEmail() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    // Helper: checks if the requester is an authorized staff/admin
    // Enforces that caller must have a verified email and match admin privileges
    function isVerifiedAdmin() {
      return isVerifiedEmail() && (
        request.auth.token.admin == true ||
        request.auth.token.email in [
          "canteen@spit.ac.in",
          "admin@spit.ac.in",
          "staff@spit.ac.in"
        ]
      );
    }

    // Orders Collection
    match /orders/{orderId} {
      // Students can create orders tied to their own authenticated UID
      // New orders can only be pending, not paid
      allow create: if request.auth != null &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.paymentStatus == 'pending';

      // Students can read their own orders; verified admins can read all orders
      allow read: if request.auth != null && (
        resource.data.userId == request.auth.uid || isVerifiedAdmin()
      );

      // Only verified admins can update order status (e.g. preparing, ready, completed, cancelled)
      allow update: if isVerifiedAdmin();

      // Deletions are forbidden to preserve order audit history
      allow delete: if false;
    }

    // Settings Collection (menu stock overrides, etc.)
    match /settings/{docId} {
      // Any authenticated or guest student can read stock availability overrides
      allow read: if true;

      // Only verified admins can update stock overrides
      allow write: if isVerifiedAdmin();
    }
  }
}
